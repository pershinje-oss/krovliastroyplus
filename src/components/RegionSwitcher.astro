---
interface Props { current: 'voronezh' | 'donetsk' }
const { current } = Astro.props;
const currentLabel = current === 'donetsk' ? 'Донецк и ДНР' : 'Воронеж и область';
---

<details class="region-switcher">
  <summary aria-label="Выбрать регион"><span>Регион:</span><strong>{currentLabel}</strong><i aria-hidden="true">⌄</i></summary>
  <div class="region-options">
    <a href="/" aria-current={current === 'voronezh' ? 'page' : undefined}>Воронеж и область</a>
    <a href="/donetsk/" aria-current={current === 'donetsk' ? 'page' : undefined}>Донецк и ДНР</a>
  </div>
</details>

<style>
  .region-switcher{position:relative;color:#fff;font-size:12px;white-space:nowrap}
  summary{display:flex;align-items:center;gap:4px;padding:8px 10px;border:1px solid #ffffff45;border-radius:5px;cursor:pointer;list-style:none;background:#ffffff0a}
  summary::-webkit-details-marker{display:none} summary i{margin-left:2px;color:#f47920;font-size:15px;font-style:normal;transition:transform .2s ease}details[open] summary i{transform:rotate(180deg)}
  .region-options{position:absolute;top:calc(100% + 8px);left:0;z-index:160;min-width:190px;padding:6px;background:#001835;border:1px solid #ffffff30;border-radius:7px;box-shadow:0 12px 30px #00183555}
  .region-options a{display:block;padding:10px 11px;border-radius:4px;color:#fff;text-decoration:none}.region-options a:hover,.region-options a:focus-visible{background:#ffffff12;color:#f47920}.region-options a[aria-current="page"]{color:#f47920;font-weight:700}
  @media(max-width:900px){.region-switcher{margin-left:auto}.region-options{left:auto;right:0}summary span{display:none}}
  @media(max-width:430px){summary{max-width:128px;overflow:hidden}summary strong{overflow:hidden;text-overflow:ellipsis}}
</style>
