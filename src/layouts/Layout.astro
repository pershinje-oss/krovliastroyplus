---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  baseHref?: string;
  ogTitle?: string;
  ogDescription?: string;
}
const {
  title = 'Кровля Строй +',
  description = 'Профессиональные кровельные работы в Воронеже и области',
  canonical = 'https://krovlya-stroy-plus.ru/',
  baseHref,
  ogTitle = title,
  ogDescription = description,
} = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {baseHref && <base href={baseHref} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://krovlya-stroy-plus.ru/images/main-banner-house-restored.webp" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <title>{title}</title>
    <!-- Yandex.Metrika counter -->
    <script is:inline>
      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a);
      })(window,document,'script','https://mc.yandex.ru/metrika/tag.js?id=111659052','ym');

      ym(111659052,'init',{ssr:true,webvisor:true,clickmap:true,ecommerce:'dataLayer',referrer:document.referrer,url:location.href,accurateTrackBounce:true,trackLinks:true});
    </script>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body>
    <noscript><div><img src="https://mc.yandex.ru/watch/111659052" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <slot />
  </body>
</html>
