---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  baseHref?: string;
  ogTitle?: string;
  ogDescription?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = 'Кровля Строй +',
  description = 'Профессиональные кровельные работы в Воронеже и области',
  canonical = 'https://krovlya-stroy-plus.ru/',
  baseHref,
  ogTitle = title,
  ogDescription = description,
  structuredData,
} = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {baseHref && <base href={baseHref} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://krovlya-stroy-plus.ru/images/main-banner-house-restored.webp" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <aside class="cookie-consent" data-cookie-consent hidden role="dialog" aria-labelledby="cookie-consent-title" aria-describedby="cookie-consent-text">
      <div>
        <strong id="cookie-consent-title">Использование файлов cookie</strong>
        <p id="cookie-consent-text">Мы используем необходимые cookie для работы сайта. С вашего согласия Яндекс Метрика используется для анализа посещаемости и эффективности рекламы. Подробнее — в <a href="/privacy/">политике обработки персональных данных</a>.</p>
      </div>
      <div class="cookie-consent__actions">
        <button type="button" data-cookie-reject>Только необходимые</button>
        <button class="cookie-consent__accept" type="button" data-cookie-accept>Принять аналитику</button>
      </div>
    </aside>
    <style is:inline>
      .cookie-consent{position:fixed;right:20px;bottom:20px;left:20px;z-index:1000;max-width:900px;margin:auto;padding:18px 20px;display:flex;align-items:center;gap:24px;border:1px solid #f47920;border-radius:10px;background:#001835;color:#fff;box-shadow:0 12px 38px #00183566;font-family:Arial,Helvetica,sans-serif}.cookie-consent[hidden]{display:none}.cookie-consent strong{display:block;margin-bottom:5px;font-size:17px}.cookie-consent p{margin:0;color:#e0e9f1;font-size:13px;line-height:1.45}.cookie-consent a{color:#fff;text-decoration:underline}.cookie-consent__actions{display:flex;flex:0 0 auto;gap:9px}.cookie-consent button{min-height:42px;padding:10px 15px;border:1px solid #fff;border-radius:5px;background:transparent;color:#fff;font-weight:700;cursor:pointer}.cookie-consent .cookie-consent__accept{border-color:#f47920;background:#f47920}.cookie-consent button:focus-visible{outline:3px solid #fff;outline-offset:2px}@media(max-width:650px){.cookie-consent{right:12px;bottom:82px;left:12px;padding:16px;align-items:stretch;flex-direction:column;gap:14px}.cookie-consent__actions{display:grid;grid-template-columns:1fr 1fr}.cookie-consent button{width:100%}}
    </style>
    <script is:inline>
      (() => {
        const consentKey = 'krovlya-cookie-consent';
        const banner = document.querySelector('[data-cookie-consent]');
        const readConsent = () => {
          try { return localStorage.getItem(consentKey); } catch { return null; }
        };
        const saveConsent = (value) => {
          try { localStorage.setItem(consentKey, value); } catch {}
        };
        const loadMetrika = () => {
          if (window.__krovlyaMetrikaLoaded) return;
          window.__krovlyaMetrikaLoaded = true;
          (function(m,e,t,r,i,k,a){
            m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
            m[i].l=1*new Date();
            k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a);
          })(window,document,'script','https://mc.yandex.ru/metrika/tag.js?id=111659052','ym');
          window.ym(111659052,'init',{ssr:true,webvisor:true,clickmap:true,ecommerce:'dataLayer',referrer:document.referrer,url:location.href,accurateTrackBounce:true,trackLinks:true});
        };
        const consent = readConsent();
        if (consent === 'accepted') loadMetrika();
        if (!consent && banner) banner.hidden = false;
        banner?.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
          saveConsent('accepted');
          banner.hidden = true;
          loadMetrika();
        });
        banner?.querySelector('[data-cookie-reject]')?.addEventListener('click', () => {
          saveConsent('rejected');
          banner.hidden = true;
          if (window.__krovlyaMetrikaLoaded) location.reload();
        });
        document.addEventListener('click', (event) => {
          const trigger = event.target.closest('[data-cookie-settings]');
          if (!trigger || !banner) return;
          event.preventDefault();
          banner.hidden = false;
          banner.querySelector('[data-cookie-accept]')?.focus();
        });
      })();
    </script>
  </body>
</html>
