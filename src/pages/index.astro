---
import Layout from '../layouts/Layout.astro';

const services = [
  [4, 'Монтаж кровли под ключ', 'Подготовка основания, монтаж покрытия, доборных элементов и водостоков.'],
  [5, 'Демонтаж крыши', 'Полный или частичный демонтаж покрытия, обрешётки и элементов конструкции.'],
  [6, 'Ремонт шиферной кровли', 'Устраняем протечки и заменяем повреждённые листы шифера.'],
  [7, 'Монтаж шифера', 'Подготавливаем основание и монтируем шиферную кровлю на объекте.'],
  [8, 'Замена кровли', 'Демонтируем старое покрытие и выполняем монтаж новой кровли.'],
  [9, 'Замена шифера', 'Частично или полностью заменяем старые и повреждённые листы.'],
];
const extraServices = [
  ['Ремонт кровли', 'Устраняем повреждения покрытия, протечки и другие дефекты крыши.'],
  ['Демонтаж старой кровли', 'Аккуратно снимаем шифер, профнастил, металл и другие покрытия.'],
  ['Демонтаж шифера', 'Снимаем старый шифер и подготавливаем крышу к дальнейшим работам.'],
  ['Замена шифера на металлочерепицу', 'Демонтируем шифер и устанавливаем новую металлочерепицу.'],
  ['Замена шифера на профнастил', 'Снимаем шифер, готовим основание и монтируем профнастил.'],
  ['Монтаж металлочерепицы', 'Монтируем покрытие, коньки и необходимые доборные элементы.'],
  ['Монтаж кровли из профнастила', 'Готовим обрешётку и устанавливаем кровельный профнастил.'],
  ['Монтаж мягкой кровли', 'Подготавливаем ровное основание и укладываем мягкую кровлю.'],
  ['Монтаж обрешётки крыши', 'Монтируем и ремонтируем обрешётку под разные виды покрытий.'],
  ['Утепление кровли', 'Устанавливаем утеплитель и защитные материалы для снижения теплопотерь.'],
  ['Монтаж водосточной системы', 'Устанавливаем желоба, трубы и элементы отвода дождевой воды.'],
  ['Устранение протечек возле дымохода', 'Герметизируем примыкания и устраняем протечки вокруг дымохода.'],
];
const works: [string, string][] = Array.from(
  { length: 19 },
  (_, index): [string, string] => [
    `images/works/work-${String(index + 1).padStart(3, '0')}.webp`,
    'center',
  ],
);
const steps = [
  [10, 'Заявка', 'Вы оставляете заявку удобным способом'], [11, 'Выезд и замер', 'Бесплатный выезд специалиста на объект и точный замер'],
  [12, 'Расчёт и смета', 'Готовим смету и фиксируем стоимость в договоре'], [13, 'Выполнение работ', 'Качественно выполняем кровельные работы'],
  [14, 'Сдача и гарантия', 'Сдаём объект и предоставляем гарантию на работы'],
];
const workAreas = [
  ['Белгородская область', 'Монтаж, ремонт и замена кровли.'],
  ['Курская область', 'Выезжаем на частные дома и другие объекты.'],
  ['Ростовская область', 'Работаем по области, в том числе в Донецке Ростовской области.'],
  ['Краснодарский край', 'Кровельные работы по предварительной договорённости.'],
  ['ДНР', 'Донецк • Макеевка • Горловка'],
  ['Мариуполь', 'Выезд на кровельные работы по согласованию.'],
];
---
<Layout
  title="Кровельные работы в Воронеже и области — ремонт, монтаж, замена | Кровля Строй +"
  description="Кровельные работы в Воронеже и Воронежской области: монтаж, ремонт и замена кровли, шифер, профнастил, металлочерепица, мягкая кровля. Более 15 лет опыта. Узнайте стоимость работ."
>
  <style is:inline>
    .desktop-call-float{position:fixed;right:24px;bottom:28px;z-index:110;width:64px;height:64px;border:0;border-radius:50%;display:grid;place-items:center;background:#f47920;box-shadow:0 7px 22px rgba(0,24,53,.32);transform:translateZ(0)}
    .desktop-call-message{position:fixed;right:103px;bottom:27px;z-index:109;display:flex;visibility:hidden;opacity:0;min-width:270px;padding:17px 22px;border:1px solid #f47920;border-radius:14px;flex-direction:column;align-items:flex-start;background:#f47920;box-shadow:0 9px 30px rgba(0,24,53,.28);transform:translateX(14px) scale(.96);transform-origin:right center;transition:opacity .22s ease,transform .28s ease,visibility 0s linear .28s}
    .desktop-call-message::after{content:'';position:absolute;right:-8px;bottom:25px;width:15px;height:15px;background:#f47920;border-top:1px solid #f47920;border-right:1px solid #f47920;transform:rotate(45deg)}
    .desktop-call-message span{color:#001835}.desktop-call-message a{color:#fff}
    .desktop-call-widget[open] .desktop-call-message{visibility:visible;opacity:1;transform:none;transition:opacity .22s ease,transform .28s ease}
    @media(max-width:600px){.desktop-call-widget{display:none}}
  </style>
  <header class="header">
    <div class="container nav">
      <a class="brand" href="#top" aria-label="Кровля Строй плюс"><img class="brand-logo" src="images/logo-krovlya.png" alt="Логотип Кровля Строй плюс"/><strong>Кровля Строй +</strong></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-menu" aria-label="Открыть меню"><span></span><span></span><span></span></button>
      <nav id="main-menu"><a href="#services">Услуги</a><a href="#works">Наши работы</a><a href="#about">О компании</a><a href="#contacts">Контакты</a></nav>
      <a class="btn small" href="tel:+79202116311" aria-label="Позвонить Ивану по номеру +7 920 211-63-11">Позвонить +7 920 211-63-11</a>
    </div>
  </header>

  <details class="desktop-call-widget">
    <summary class="desktop-call-float" aria-label="Показать наш номер телефона">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.7 2.8 9.4 2c.7-.2 1.4.2 1.7.9l1.2 3.2c.2.6 0 1.3-.5 1.7l-1.7 1.4a14.5 14.5 0 0 0 4.7 4.7l1.4-1.7c.4-.5 1.1-.7 1.7-.5l3.2 1.2c.7.3 1.1 1 1 1.7l-.9 2.7c-.3 1-1.2 1.7-2.2 1.7C10.7 19 5 13.3 5 6c0-1 .7-1.9 1.7-2.2Z"/></svg>
    </summary>
    <div class="desktop-call-message"><span>Наш номер телефона</span><a href="tel:+79202116311">+7 920 211-63-11</a></div>
  </details>

  <main id="top">
    <section class="hero">
      <div class="container hero-copy">
        <h1>Кровельные работы в Воронеже и Воронежской области</h1>
        <p>Монтаж, ремонт и замена кровли частных домов. Работаем с шифером, профнастилом, металлочерепицей и мягкой кровлей.</p>
        <p class="accent">Более 15 лет занимаемся кровельными работами. Поможем подобрать решение под состояние крыши и ваш бюджет.</p>
        <div class="actions"><a class="btn" href="tel:+79202116311" aria-label="Позвонить Ивану по номеру +7 920 211-63-11">Позвонить</a><a class="btn ghost" href="#works">Посмотреть работы</a></div>
      </div>
    </section>

    <section class="benefits" id="about"><div class="container benefit-grid">
      <div><img class="benefit-icon" src="images/benefit-icons/benefit-1.png?v=2" alt="" width="83" height="83" style="width:83px;height:83px;object-fit:contain;display:block;flex:0 0 83px"/><p><strong>Только кровельные работы</strong><span>Монтаж, ремонт, замена и демонтаж кровли.</span></p></div>
      <div><img class="benefit-icon" src="images/benefit-icons/benefit-2.png?v=2" alt="" width="83" height="83" style="width:83px;height:83px;object-fit:contain;display:block;flex:0 0 83px"/><p><strong>Более 15 лет опыта</strong><span>Работаем с шифером, профнастилом, металлочерепицей и мягкой кровлей.</span></p></div>
      <div><img class="benefit-icon" src="images/benefit-icons/benefit-3.png?v=2" alt="" width="83" height="83" style="width:83px;height:83px;object-fit:contain;display:block;flex:0 0 83px"/><p><strong>Проверенные материалы</strong><span>Поможем подобрать надёжное покрытие под задачу и бюджет.</span></p></div>
      <div><img class="benefit-icon" src="images/benefit-icons/benefit-4.png?v=2" alt="" width="83" height="83" style="width:83px;height:83px;object-fit:contain;display:block;flex:0 0 83px"/><p><strong>Понятная стоимость работ</strong><span>Сначала оцениваем объект и согласовываем объём работ и стоимость.</span></p></div>
    </div></section>

    <section class="section container services-section" id="services"><h2>Наши услуги</h2><div class="service-grid">
      {services.map((s, i) => <article class={`service s${i}`}><div><h3>{s[1]}</h3><p>{s[2]}</p></div></article>)}
    </div>
    <button class="services-open" type="button" aria-controls="extra-services" aria-expanded="false" aria-label="Показать все услуги"><span></span></button>
    <div class="services-expansion" id="extra-services" aria-hidden="true">
      <div class="extra-services-grid">
        {extraServices.map((s, i) => <article class={`extra-service extra-${i}`}><div><h3>{s[0]}</h3><p>{s[1]}</p></div></article>)}
      </div>
      <button class="services-close" type="button" aria-label="Свернуть дополнительные услуги"><span></span></button>
    </div>
    </section>

    <section class="section container works" id="works"><h2>Наши работы</h2><div class="works-carousel">
      {works.length > 1 && <button class="carousel-button carousel-prev" type="button" aria-label="Предыдущие работы"><span></span></button>}
      <div class="work-track" tabindex="0" aria-label="Фотографии выполненных работ">
        {works.map((w, index) => <article class="work-slide"><img class="work-photo" src={w[0]} alt={`Выполненная кровельная работа ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async"/></article>)}
      </div>
      {works.length > 1 && <button class="carousel-button carousel-next" type="button" aria-label="Следующие работы"><span></span></button>}
    </div></section>

    <section class="section container process"><h2>Как мы работаем</h2><div class="steps">
      {steps.map((s, i) => <article><i>{i + 1}</i><b><span class={`sprite i${s[0]}`}></span></b><strong>{s[1]}</strong><p>{s[2]}</p></article>)}
    </div></section>

    <section class="container social-hub" aria-labelledby="social-hub-title">
      <div class="social-hub-heading">
        <h2 id="social-hub-title">Дорогие клиенты и друзья!</h2>
        <p>Подписывайтесь на наши площадки и оставляйте отзывы</p>
      </div>
      <div class="social-hub-grid">
        <a class="social-hub-card social-vk" href="https://vk.ru/club240862938" target="_blank" rel="noopener noreferrer" aria-label="Открыть сообщество Кровля Строй плюс во ВКонтакте">
          <span class="social-hub-icon"><img src="images/social-vk.png" alt=""/></span>
          <span><strong>ВКонтакте</strong><small>Новости и наши работы</small></span>
          <i aria-hidden="true">›</i>
        </a>
        <a class="social-hub-card social-avito" href="https://www.avito.ru/brands/d5ec80d5603dd79f2cbab1683bd662ff/all/predlozheniya_uslug?gdlkerfdnwq=101&amp;page_from=from_item_card&amp;iid=8188865110&amp;sellerId=263aaddaba39b55ed832c34944827d0e" target="_blank" rel="noopener noreferrer" aria-label="Открыть объявления Кровля Строй плюс на Авито">
          <span class="social-hub-icon"><img src="images/social-avito.png" alt=""/></span>
          <span><strong>Авито</strong><small>Наши объявления</small></span>
          <i aria-hidden="true">›</i>
        </a>
        <a class="social-hub-card social-yandex" href="https://yandex.ru/profile/237934494146" target="_blank" rel="noopener noreferrer" aria-label="Открыть профиль Кровля Строй плюс на Яндексе">
          <span class="social-hub-icon"><img src="images/social-yandex.png" alt=""/></span>
          <span><strong>Яндекс</strong><small>Профиль и отзывы</small></span>
          <i aria-hidden="true">›</i>
        </a>
      </div>
      <p class="social-hub-thanks">Спасибо за доверие и рекомендации!</p>
    </section>

    <section class="container regions-banner" aria-labelledby="regions-banner-title">
      <div class="regions-banner-photo"><img src="images/regions-donetsk-banner.png" alt="Дорога и указатель на Донецк" loading="lazy" decoding="async"/></div>
      <div class="regions-banner-copy">
        <h2 id="regions-banner-title">Работаем и в других регионах</h2>
        <p>Выполняем кровельные работы не только в Воронежской области.<br/>Выезжаем на объекты в Донецке и других городах ДНР.</p>
        <a class="btn regions-banner-button" href="#contacts">Подробнее о регионах</a>
      </div>
    </section>

    <section class="container maxbox" id="max"><div class="maxlogo"><img src="images/max-icon.png" alt="MAX"/></div><div class="maxintro"><h2>Уточнить стоимость</h2><p>Напишите нам в MAX — ответим на вопросы,<br/>проконсультируем и рассчитаем стоимость вашей кровли.</p></div><div class="maxfeature"><span class="sprite i15"></span><span>Быстрый ответ<br/>в MAX</span></div><div class="maxfeature"><span class="sprite i16"></span><span>Подробная<br/>консультация</span></div><div class="maxfeature"><span class="sprite i17"></span><span>Расчёт стоимости<br/>под ваш проект</span></div><div class="max-actions"><a class="btn" href="https://max.ru/u/f9LHodD0cOJqLcMP3FbJaKl8EmVlN1m9yWeDXsfwCbYhnD9CC50KMyQBK4A" target="_blank" rel="noopener noreferrer">Уточнить стоимость в MAX</a><a class="btn max-call-btn" href="tel:+79202116311" aria-label="Позвонить Ивану по номеру +7 920 211-63-11">Позвонить</a></div></section>

  </main>

  <footer id="contacts"><div class="container footer-grid"><div class="brandfoot"><div class="brand"><img class="brand-logo" src="images/logo-krovlya.png" alt="Логотип Кровля Строй плюс"/><strong>Кровля Строй +</strong></div><p>Профессиональные кровельные работы<br/>в Воронеже и области.<br/>Более 15 лет опыта. Качество и надёжность.</p></div><div><span class="footer-contact-icon phone-svg" role="img" aria-label="Телефон"></span><span>Иван<br/><a class="footer-phone" href="tel:+79202116311">+7 920 211-63-11</a></span></div><a class="footer-contact-link" href="https://max.ru/u/f9LHodD0cOJqLcMP3FbJaKl8EmVlN1m9yWeDXsfwCbYhnD9CC50KMyQBK4A" target="_blank" rel="noopener noreferrer"><img class="footer-social-icon" src="images/max-footer-icon-v2.png" alt="MAX"/><span>MAX<br/><b>Напишите в MAX</b></span></a><div><img class="footer-social-icon" src="images/vk-icon.png" alt="ВКонтакте"/><span>ВКонтакте<br/><b>Мы в соцсетях</b></span></div><div><span class="footer-contact-icon location-svg" role="img" aria-label="Местоположение"></span><span>Воронеж и область<br/><b>Работаем по всему региону</b></span></div></div><p class="copyright">© Кровля Строй +. Все права защищены.</p></footer>
  <nav class="mobile-contact-bar" aria-label="Быстрая связь">
    <a class="mobile-contact-button mobile-contact-call" href="tel:+79202116311" aria-label="Позвонить Ивану по номеру +7 920 211-63-11"><span aria-hidden="true">☎</span>Позвонить</a>
    <a class="mobile-contact-button mobile-contact-max" href="https://max.ru/u/f9LHodD0cOJqLcMP3FbJaKl8EmVlN1m9yWeDXsfwCbYhnD9CC50KMyQBK4A" target="_blank" rel="noopener noreferrer" aria-label="Написать в MAX"><img src="images/max-icon.png" alt="" aria-hidden="true"/>MAX</a>
  </nav>
</Layout>

<style is:inline>
  *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;color:#001835;background:#fff;font-family:Arial,Helvetica,sans-serif} .container{width:min(1180px,calc(100% - 40px));margin:auto}.header{height:76px;background:#001835;color:#fff}.nav{height:100%;display:flex;align-items:center;gap:34px}.brand{display:flex;align-items:center;gap:11px;color:#fff;text-decoration:none;font-size:23px;white-space:nowrap}.brand-logo{display:block;width:82px;height:48px;object-fit:contain}.roofmark{font-size:38px;color:#f47a23;line-height:1}.nav nav{display:flex;gap:35px;margin-left:18px}.nav nav a{color:#fff;text-decoration:none;font-size:14px}.nav>.btn{margin-left:auto}.btn{display:inline-flex;align-items:center;justify-content:center;background:#f47920;color:#fff;text-decoration:none;border-radius:4px;padding:14px 22px;font-weight:700;font-size:14px;box-shadow:0 3px 8px #0002}.btn.small{padding:13px 18px;white-space:nowrap}.hero{height:435px;background:linear-gradient(90deg,rgba(0,24,53,.93) 0%,rgba(0,24,53,.7) 42%,rgba(0,24,53,.08) 72%),url('images/main-banner-roofers-wide.webp?v=1') center/cover no-repeat;color:#fff}.hero-copy{padding-top:46px}.hero h1{font-size:47px;line-height:1.11;margin:0 0 16px;letter-spacing:-1px}.hero p{font-size:18px;line-height:1.4;margin:0 0 10px}.hero .accent{color:#ff8a30;font-weight:700}.actions{display:flex;gap:16px;margin-top:20px}.btn.ghost{background:transparent;border:1px solid #fff}.benefits{border-bottom:1px solid #e7e7e7}.benefit-grid{display:grid;grid-template-columns:repeat(4,1fr);padding:23px 0}.benefit-grid>div{display:flex;align-items:center;gap:17px;padding:0 18px;border-right:1px solid #e5e5e5}.benefit-grid>div:last-child{border:0}.benefit-grid b{width:83px;height:83px;flex:0 0 83px;border:2px solid #001835;border-radius:50%;display:grid;place-items:center;font-size:34px}.benefit-grid p{margin:0;font-size:13px}.benefit-grid strong,.benefit-grid span{display:block}.benefit-grid span{margin-top:9px;color:#4b5560;line-height:1.25}.section{padding:21px 0;border-bottom:1px solid #ececec}.section h2,.maxintro h2{font-size:25px;text-align:center;margin:0 0 24px}.section h2:after{content:'';display:block;width:38px;height:3px;background:#f47a23;margin:9px auto 0}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.service{height:189px;border-radius:4px;overflow:hidden;position:relative;display:flex;align-items:flex-end;color:#fff;padding:18px;background-image:linear-gradient(0deg,rgba(0,24,53,.92),rgba(0,24,53,.22)),url('images/roof-hero.png');background-size:cover}.service.s0{background-position:0 70%}.service.s1{background-position:35% 60%}.service.s2{background-position:70% 65%}.service.s3{background-position:10% 90%}.service.s4{background-position:50% 88%}.service.s5{background-position:95% 85%}.round{position:absolute;top:15px;left:17px;width:59px;height:59px;border-radius:50%;display:grid;place-items:center;background:#001835;border:1px solid #9ab3c6;font-size:28px}.service h3{font-size:22px;margin:0 0 7px}.service p{font-size:14px;line-height:1.35;margin:0}.works{padding-top:25px}.work-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}.work-photo{height:157px;background-image:url('images/roof-hero.png');background-size:500% auto}.work-grid p{text-align:center;margin:8px 0 0;font-size:13px;line-height:1.3;color:#4c5661}.work-grid span{color:#001835}.process{padding-top:25px}.steps{display:grid;grid-template-columns:repeat(5,1fr);gap:28px}.steps article{text-align:center;position:relative}.steps article:not(:last-child):after{content:'›';position:absolute;right:-20px;top:47px;color:#b7bec4;font-size:42px}.steps i{position:absolute;left:5px;top:0;width:31px;height:31px;border-radius:50%;background:#001835;color:#fff;font:bold 16px/31px Arial}.steps b{display:block;font-size:54px;height:68px;font-weight:400}.steps strong{font-size:13px;display:block}.steps p{font-size:11px;color:#59636c;line-height:1.35}.maxbox{min-height:143px;margin-top:10px;background: