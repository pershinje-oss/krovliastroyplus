  @media(max-width:600px){.regions-banner{grid-template-columns:1fr;min-height:0}.regions-banner-photo{height:155px}.regions-banner-photo::after{background:linear-gradient(180deg,transparent 60%,#eaf4ff 100%)}.regions-banner-copy{align-items:center;padding:25px 20px 28px;text-align:center}.regions-banner-copy h2{font-size:24px}.regions-banner-copy h2::after{margin-left:auto;margin-right:auto}.regions-banner-copy p br{display:none}.regions-banner-button{width:100%}}
  .desktop-call-float{position:fixed;right:24px;bottom:28px;left:auto;top:auto;z-index:110;width:64px;height:64px;padding:0;border:0;border-radius:50%;display:grid;visibility:visible;opacity:1;place-items:center;background:#f47920;color:#001835;text-decoration:none;box-shadow:0 7px 22px rgba(0,24,53,.32);transform:translateZ(0);backface-visibility:hidden;isolation:isolate;will-change:transform;cursor:pointer;-webkit-tap-highlight-color:transparent}
  .desktop-call-float{list-style:none}.desktop-call-float::-webkit-details-marker{display:none}
  .desktop-call-float::before,.desktop-call-float::after{content:'';position:absolute;inset:0;z-index:-1;border:2px solid #f47920;border-radius:50%;animation:call-pulse 2s ease-out infinite}
  .desktop-call-float::after{animation-delay:1s}
  .desktop-call-float svg{width:34px;height:34px;fill:none;stroke:#001835;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round;transform-origin:center;animation:phone-ring 1.8s ease-in-out infinite}
  .desktop-call-float:hover{background:#ff8a30;box-shadow:0 9px 28px rgba(0,24,53,.4)}
  .desktop-call-float:focus-visible{outline:3px solid #001835;outline-offset:4px}
  .desktop-call-message{position:fixed;right:103px;bottom:27px;z-index:109;display:flex;visibility:hidden;opacity:0;min-width:270px;padding:17px 22px;border:1px solid #f47920;border-radius:14px;flex-direction:column;align-items:flex-start;background:#f47920;box-shadow:0 9px 30px rgba(0,24,53,.28);transform:translateX(14px) scale(.96);transform-origin:right center;transition:opacity .22s ease,transform .28s cubic-bezier(.22,1,.36,1),visibility 0s linear .28s}
  .desktop-call-message::after{content:'';position:absolute;right:-8px;bottom:25px;width:15px;height:15px;background:#f47920;border-top:1px solid #f47920;border-right:1px solid #f47920;transform:rotate(45deg)}
  .desktop-call-message span{color:#001835;font-size:14px;font-weight:700;line-height:1.2}
  .desktop-call-message a{position:relative;z-index:1;margin-top:4px;color:#fff;font-size:21px;font-weight:700;text-decoration:none;white-space:nowrap}
