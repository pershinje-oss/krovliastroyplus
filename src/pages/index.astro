</style>

<script>
  const openButton = document.querySelector<HTMLButtonElement>('.services-open');
  const closeButton = document.querySelector<HTMLButtonElement>('.services-close');
  const expansion = document.querySelector<HTMLElement>('.services-expansion');
  const servicesSection = document.querySelector<HTMLElement>('.services-section');
  const setExpanded = (expanded: boolean) => {
    if (!openButton || !closeButton || !expansion || !servicesSection) return;
    expansion.classList.toggle('is-open', expanded);
    servicesSection.classList.toggle('is-expanded', expanded);
    expansion.setAttribute('aria-hidden', String(!expanded));
    openButton.setAttribute('aria-expanded', String(expanded));
    if (!expanded) {
      document.querySelector('#services')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.setTimeout(() => openButton.focus(), 450);
    }
  };
  openButton?.addEventListener('click', () => setExpanded(true));
  closeButton?.addEventListener('click', () => setExpanded(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && expansion?.classList.contains('is-open')) setExpanded(false);
  });

  const workTrack = document.querySelector<HTMLElement>('.work-track');
  const previousWork = document.querySelector<HTMLButtonElement>('.carousel-prev');
  const nextWork = document.querySelector<HTMLButtonElement>('.carousel-next');
  const carouselStep = () => {
    const slide = workTrack?.querySelector<HTMLElement>('.work-slide');
    if (!workTrack || !slide) return 0;
    return slide.getBoundingClientRect().width + 10;
  };
  const updateCarouselButtons = () => {
    if (!workTrack || !previousWork || !nextWork) return;
    previousWork.disabled = workTrack.scrollLeft <= 2;
    nextWork.disabled = workTrack.scrollLeft >= workTrack.scrollWidth - workTrack.clientWidth - 2;
  };
  previousWork?.addEventListener('click', () => workTrack?.scrollBy({ left: -carouselStep(), behavior: 'smooth' }));
  nextWork?.addEventListener('click', () => workTrack?.scrollBy({ left: carouselStep(), behavior: 'smooth' }));
  workTrack?.addEventListener('scroll', updateCarouselButtons, { passive: true });
  workTrack?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') workTrack.scrollBy({ left: -carouselStep(), behavior: 'smooth' });
    if (event.key === 'ArrowRight') workTrack.scrollBy({ left: carouselStep(), behavior: 'smooth' });
  });
  window.addEventListener('resize', updateCarouselButtons);
  updateCarouselButtons();

  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const mainMenu = document.querySelector<HTMLElement>('#main-menu');
  const setMenuOpen = (open: boolean) => {
    if (!menuToggle || !mainMenu) return;
    menuToggle.classList.toggle('is-open', open);
    mainMenu.classList.toggle('is-open', open);
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
  };
  menuToggle?.addEventListener('click', () => setMenuOpen(!mainMenu?.classList.contains('is-open')));
  mainMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenuOpen(false);
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth > 900) setMenuOpen(false);
  });

</script>
