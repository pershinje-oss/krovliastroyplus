  /* Точный дизайн и центрирование кнопок раскрытия услуг. */
  .services-open{position:relative;left:50%;width:50px;height:42px;margin:14px 0 -8px;padding:0;display:grid;place-items:center;border:0;background:transparent;transform:translateX(-50%)}
  .services-open:hover{transform:translateX(-50%)}
  .services-open span{display:block;width:18px;height:18px;color:#f47920;border-right:4px solid #f47920;border-bottom:4px solid #f47920;transform:rotate(45deg);animation:service-arrow-down 1.2s ease-in-out infinite}
  .services-close{left:50%;bottom:28px;width:60px;height:60px;padding:0;border:0;border-radius:50%;background:#f47920;color:#001835;display:grid;place-items:center;transform:translate(-50%,30px) scale(.7)}
  .services-close span{display:block;width:18px;height:18px;border-right:4px solid #001835;border-bottom:4px solid #001835;transform:rotate(45deg);animation:service-arrow-down 1.2s ease-in-out infinite}
